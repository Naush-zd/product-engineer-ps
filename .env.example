# Copy to .env or export directly. No secret values belong in this file.
# All variables are optional; sensible defaults let the service run with none set.

# The single webhook endpoint deliveries are POSTed to.
WEBHOOK_URL=http://localhost:9000/hook

# Maximum HTTP attempts before a delivery is marked failed_permanent.
MAX_ATTEMPTS=5

# Backoff base in seconds; delay before attempt N is BASE * 2**(N-1), capped.
BASE_BACKOFF_SECONDS=2
MAX_BACKOFF_SECONDS=300

# How often the background worker polls for due deliveries.
POLL_INTERVAL_SECONDS=0.5

# Per-request timeout when calling the receiver.
REQUEST_TIMEOUT_SECONDS=5

# How long a claim is valid before a crashed worker's delivery is reclaimed.
CLAIM_LEASE_SECONDS=30

# SQLite database file for durable state.
DB_PATH=webhooks.db

# API bind host/port and log level (used by app.main).
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
